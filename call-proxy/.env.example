# Copy to .env on the HOST (never commit the real .env, never put these in site files).
# Get the private key + IDs from the Vapi dashboard.

VAPI_PRIVATE_KEY=sk_live_xxx        # Vapi private (server) key — secret
VAPI_ASSISTANT_ID=asst_xxx          # the AI agent that runs the call script
VAPI_PHONE_NUMBER_ID=pn_xxx         # the Vapi phone number that places the call

# Guardrails (defaults shown; tighten as needed)
ALLOWED_ORIGIN=https://targetdigital.com.au
RATE_LIMIT_MAX=5                    # max calls per IP per window
RATE_LIMIT_WINDOW_MS=3600000       # window = 1 hour
MAX_CALLS_PER_DAY=25               # global hard cap on real calls per UTC day (backstop vs IP rotation)
ALLOWED_COUNTRY_PREFIXES=+61       # comma list of allowed dial prefixes, e.g. "+61,+64"; blocks toll-fraud
PORT=3000
